{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avyrontech",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    }
  },

  // ─── Bindings ────────────────────────────────────────────────────────
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "avyron-db",
      "database_id": "85b6868d-174a-48aa-8891-9366bbcb7e47",
      "migrations_dir": "../../d1/migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "KV", "id": "7c296f2750b943cea4376c12122ed276" }
  ],
  "r2_buckets": [
    // FILES  = documente private per proiect (upload din intern, atașamente proposals)
    { "binding": "FILES", "bucket_name": "avyron-files" },
    // MEDIA  = active publice (logo-uri, portfolio, cover images, og)
    { "binding": "MEDIA", "bucket_name": "avyron-media" }
  ],

  // Secrete (setate prin `wrangler secret put`):
  //   JWT_SECRET, SEED_TOKEN
  "vars": {
    "ALLOWED_ORIGINS": "https://avyron.ro,https://www.avyron.ro,https://avyrontech.lovable.app,https://id-preview--3432ba2d-bd12-41f5-9dc2-a3e04fe788d0.lovable.app,https://3432ba2d-bd12-41f5-9dc2-a3e04fe788d0.lovableproject.com,http://localhost:8080"
  }
}
