{
  "name": "avyron-api",
  "private": true,
  "type": "module",
  "description": "Server-only SDK dependencies; isolated from the React 18 frontend.",
  "engines": { "node": ">=22 <25" },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:remote": "wrangler d1 migrations apply avyron-db --remote",
    "migrate:local": "wrangler d1 migrations apply avyron-db --local"
  },
  "dependencies": {
    "hono": "^4.13.3",
    "agents": "0.22.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260908.1",
    "wrangler": "4.130.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
