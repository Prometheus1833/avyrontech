{
  "name": "avyron-api",
  "private": true,
  "type": "module",
  "description": "Server-only SDK dependencies; isolated from the React 18 frontend.",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:remote": "wrangler d1 migrations apply avyron-db --remote",
    "migrate:local": "wrangler d1 migrations apply avyron-db --local"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.31.0",
    "hono": "^4.13.3",
    "svix": "^1.99.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260908.1",
    "wrangler": "4.155.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
