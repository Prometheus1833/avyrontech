{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Primary Worker connected to GitHub. Keeping this config at repository
  // root makes Cloudflare's default `wrangler versions upload` preview command
  // deterministic without duplicating bindings in dashboard-only settings.
  "name": "avyrontech",
  "main": "cloudflare/workers/api/src/index.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // API calls must always reach Hono. Authenticated/private browser routes
    // also pass through the Worker so it can attach noindex + no-store.
    "run_worker_first": [
      "/api/*",
      "/auth",
      "/auth/*",
      "/autentificare",
      "/autentificare/*",
      "/profil",
      "/profil/*",
      "/intern",
      "/intern/*",
      "/forgot-password",
      "/reset-password",
      "/unsubscribe"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    }
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "avyron-db",
      "database_id": "85b6868d-174a-48aa-8891-9366bbcb7e47",
      "migrations_dir": "cloudflare/d1/migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "KV", "id": "7c296f2750b943cea4376c12122ed276" }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "avyron-files" },
    { "binding": "MEDIA", "bucket_name": "avyron-media" }
  ],

  // Secrets: JWT_SECRET, SEED_TOKEN, SMTP_PASS, TURNSTILE_SECRET.
  "vars": {
    "ALLOWED_ORIGINS": "https://avyron.ro,https://www.avyron.ro,https://avyrontech.lovable.app,https://id-preview--3432ba2d-bd12-41f5-9dc2-a3e04fe788d0.lovable.app,https://3432ba2d-bd12-41f5-9dc2-a3e04fe788d0.lovableproject.com,http://localhost:8080",
    "APP_URL": "https://avyron.ro",
    "SMTP_HOST": "smtp.mx.cloudflare.net",
    "SMTP_PORT": "465",
    "SMTP_USER": "api_token",
    "SMTP_FROM": "contact@avyron.ro",
    "LEAD_TO": "avyrontech@gmail.com",
    "TURNSTILE_ALLOWED_HOSTNAMES": "avyron.ro,www.avyron.ro,avyrontech.pages.dev,*.avyrontech.pages.dev,avyrontech.lovable.app,localhost"
  }
}
