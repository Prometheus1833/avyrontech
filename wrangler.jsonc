{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avyrontech",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },

  // ─── Cloudflare backend bindings ─────────────────────────────────────
  // Bindings live alături de SPA → API-ul răspunde same-origin pe /api/*.
  // Resurse create de tine (account: 51abbee1bab5f1fc9bfbfd9dcea5f3dc).
  // JWT_SECRET trebuie pus o singură dată cu:
  //   bunx wrangler secret put JWT_SECRET
  //   (lipește output de la: openssl rand -hex 48)

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "avyron-db",
      "database_id": "85b6868d-174a-48aa-8891-9366bbcb7e47",
      "migrations_dir": "cloudflare/d1/migrations"
    }
  ],

  "kv_namespaces": [
    { "binding": "KV", "id": "7c296f2750b943cea4376c12122ed276" }
  ],

  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "avyron-files" }
  ],

  "vars": {
    "APP_ORIGIN": "https://avyrontech.avyrontech.workers.dev"
  }
}
