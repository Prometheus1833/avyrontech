{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avyrontech",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }

  // ──────────────────────────────────────────────────────────────────────
  // Cloudflare backend — infrastructură pregătită, comentată până la activare.
  // Vezi `cloudflare/README.md` pentru regula KV / D1 / R2 / Workers.
  //
  // Activare (o singură dată):
  //   bunx wrangler d1 create avyron-db
  //   bunx wrangler kv namespace create AVYRON_KV
  //   bunx wrangler r2 bucket create avyron-files
  //
  // Apoi decomentează blocurile de mai jos și completează ID-urile.
  // ──────────────────────────────────────────────────────────────────────

  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "avyron-db",
  //     "database_id": "REPLACE_WITH_REAL_ID",
  //     "migrations_dir": "cloudflare/d1/migrations"
  //   }
  // ],
  //
  // "kv_namespaces": [
  //   {
  //     "binding": "KV",
  //     "id": "REPLACE_WITH_REAL_ID",
  //     "preview_id": "REPLACE_WITH_PREVIEW_ID"
  //   }
  // ],
  //
  // "r2_buckets": [
  //   {
  //     "binding": "FILES",
  //     "bucket_name": "avyron-files",
  //     "preview_bucket_name": "avyron-files-preview"
  //   }
  // ]
}
