{
  "schemaVersion": 6,
  "project": {
    "id": "aip_avyron_web",
    "slug": "avyron-web",
    "agent": "ai-prod-content"
  },
  "identity": {
    "tone": ["premium", "tech", "minimalist", "clar", "uman", "profesionist", "orientat spre conversii"],
    "primaryOffer": "Website-uri de prezentare premium, rapide, accesibile si optimizate pentru conversii.",
    "website": "https://avyron.ro",
    "email": "contact@avyron.ro",
    "phone": "0734 605 055",
    "contactRule": "Datele de contact apar numai cand sprijina intentia si nu aglomereaza compozitia."
  },
  "publishing": {
    "timezone": "Europe/Bucharest",
    "humanApprovalRequired": true,
    "verifiedConnectorRequired": true,
    "freeOnly": true,
    "cadence": {
      "postsPerDay": 1,
      "imagesPerDay": 1,
      "reelEveryDays": 3,
      "weeklyArticle": { "weekday": 5, "time": "16:00" }
    },
    "hashtags": { "feedMin": 5, "feedMax": 10, "storyMax": 0 }
  },
  "composition": {
    "storyCanvas": { "width": 1080, "height": 1920 },
    "storySafeZonePx": { "top": 180, "bottom": 250, "left": 72, "right": 72 },
    "feedSafeZonePercent": 8,
    "rules": [
      "Mesajul principal ramane lizibil dupa afisarea numelui contului si a controalelor platformei.",
      "CTA-ul nu se plaseaza in treimea inferioara rezervata raspunsurilor si reactiilor.",
      "Vizualul arata clar produsul digital sau rezultatul unui website, nu doar decor abstract.",
      "Textul critic, logo-ul si interfetele finale se compun separat, nu se lasa in imaginea generata.",
      "Scenele cu oameni trec verificari pentru anatomie, maini, reflexii, perspectiva, lumina si ecrane credibile.",
      "Se verifica previzualizarea publicata pe mobil inainte de reutilizare."
    ]
  },
  "productionOrchestration": {
    "realAssetsFirst": true,
    "stages": ["research", "tool_plan", "real_asset_capture", "visual_production", "copy", "platform_finish", "visual_qa", "approval"],
    "requiredToolPlanFields": ["stage", "tool", "purpose", "input", "output", "fallback"],
    "assetOrder": ["real_avyron_capture", "verified_client_or_stock_asset", "generated_universal_scene"],
    "criticalTextGeneratedInImage": false,
    "threePassQa": ["editorial_factual", "visual_mobile", "native_conversion"],
    "requiredMetadata": ["tool_plan", "asset_provenance", "creative_fingerprint", "visual_qa"]
  },
  "contentSystem": {
    "sourceQuestionRequired": true,
    "editorialMechanisms": ["information_gap", "self_reference", "proof_story", "immediate_value"],
    "longCaption": ["hook", "diagnostic", "concrete_value", "avyron_connection", "single_cta", "specific_target_url"],
    "story": {
      "defaultFrameCount": 3,
      "sequence": ["recognition", "mechanism_or_proof", "action_or_conversion"],
      "microcopyRequiredPerFrame": true,
      "storyCaptionRequiredWhenSupported": true,
      "unsupportedCaptionMustBeExplicit": true,
      "specificLinkStickerPreferred": true,
      "finalConversionFrame": {
        "optional": true,
        "cta": "Cere o cotatie",
        "fields": ["name", "email"],
        "privacyNoticeRequired": true,
        "verifiedNativeOrHostedFormOnly": true
      }
    },
    "shortVideo": {
      "hookWindowSeconds": [0, 2],
      "framesFor15To30Seconds": [5, 8],
      "framesFor30To45Seconds": [7, 12],
      "singleStaticImageVideoForbidden": true,
      "photoModeFallbackFrames": [4, 7],
      "requiredFieldsPerFrame": ["duration", "purpose", "visual", "screen_text", "voice_over", "transition", "audio_cue", "safe_zone"],
      "nativeVariants": ["instagram_reel", "facebook_reel", "tiktok"]
    },
    "learning": {
      "reviewWindowsHours": [24, 72, 168],
      "singleVariableTests": ["hook", "frame_count", "cta", "cover", "duration", "time"],
      "minimumComparablePosts": 2
    }
  },
  "links": {
    "storyPriority": ["native_link_sticker", "profile_link", "visible_avyron_ro"],
    "feedPriority": ["native_clickable_url", "first_comment_when_appropriate", "visible_avyron_ro"],
    "defaultUrl": "https://avyron.ro",
    "defaultServiceUrl": "https://avyron.ro/servicii/website-prezentare-profesional",
    "specificTargets": {
      "services": "https://avyron.ro/servicii",
      "professionalWebsite": "https://avyron.ro/servicii/website-prezentare-profesional",
      "onlineStore": "https://avyron.ro/servicii/magazin-online",
      "professionalBlog": "https://avyron.ro/servicii/blog-profesional",
      "applications": "https://avyron.ro/servicii/aplicatii-si-platforme",
      "automationAi": "https://avyron.ro/servicii/automatizari-si-ai",
      "qa": "https://avyron.ro/servicii/qa-testing-web-mobile",
      "socialIdentity": "https://avyron.ro/servicii/identitate-social-media",
      "dynamicLogo": "https://avyron.ro/servicii/creare-logo-3d-dinamic-cinematic",
      "articlePattern": "https://avyron.ro/blog/<slug>"
    },
    "allowedConversionRoots": ["/", "/servicii", "/produse", "/blog"],
    "facebook": {
      "maximumVisibleLinks": 1,
      "stripQueryAndFragment": true,
      "forbidExampleUrls": true,
      "forbidExternalConversionUrls": true,
      "placement": "caption_end",
      "selectionOrder": ["exact_service_or_product", "service_category", "professional_website_service", "homepage"]
    }
  },
  "nativeElements": {
    "instagram": ["music", "link_sticker", "poll", "captions", "subtle_emoji", "story_caption_when_supported"],
    "facebook": ["music", "link_sticker", "poll", "subtle_emoji", "page_action_button_when_verified"],
    "tiktok": ["native_music", "captions", "transitions", "motion_effects", "text_timing", "organic_lead_form_when_free_verified"],
    "threads": ["concise_hook", "conversation_prompt", "native_reply"],
    "linkedin": ["professional_hook", "document_carousel", "external_link_when_relevant"],
    "whatsapp": ["short_status_copy", "visible_domain"]
  },
  "conversion": {
    "freeOnly": true,
    "preferredModes": ["native_organic_form", "verified_hosted_form", "link_sticker", "action_button"],
    "defaultCta": "Cere o cotatie",
    "formFields": ["name", "email"],
    "optionalField": "need",
    "privacyNoticeRequired": true,
    "marketingConsentPrechecked": false,
    "formStatuses": ["verified_available", "unsupported", "awaiting_connection"],
    "forbidLeadDataCollectionIn": ["comments", "polls", "direct_messages"],
    "inboundHandoff": "leads_crm",
    "separateApprovalRequiredFor": ["form_change", "action_button_change", "profile_change", "publish", "schedule"]
  },
  "quality": {
    "minimumScore": 90,
    "checks": ["brand_fit", "clarity", "website_offer_visible", "mobile_legibility", "safe_zones", "native_adaptation", "story_microcopy", "story_caption", "video_progression", "specific_target_url", "cta", "form_verification", "asset_provenance", "anatomy", "hands", "reflections", "perspective", "screen_ui", "contrast", "accessibility", "truthfulness", "originality"]
  },
  "backup": {
    "metadataStore": "D1",
    "objectStore": "private R2 FILES",
    "localFormat": "versioned JSON manifest with SHA-256 checksums",
    "excluded": ["access_tokens", "refresh_tokens", "cookies", "session_data", "connector_secrets", "private_messages"],
    "retentionDays": 90
  }
}
